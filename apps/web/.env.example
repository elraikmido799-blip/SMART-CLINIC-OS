# انسخ الملف ده لـ.env.local وحط القيم الحقيقية

# لينك الموقع (للـSEO والـsitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# لينك الـAPI بتاع مبرمج الباك
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# enabled = داتا وهمية (Mocks) · disabled = الـAPI الحقيقي
NEXT_PUBLIC_API_MOCKING=enabled

# على السيرفر بس: يجرّب حالات الأخطاء على الـMocks — ok · empty · network · server · not-found · invalid
MOCK_SCENARIO=ok

# رقم الواتساب بالصيغة الدولية من غير + (مثال: 201000000000)
NEXT_PUBLIC_WHATSAPP_NUMBER=
